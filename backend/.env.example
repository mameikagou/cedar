# Copy to backend/.env and supply your own credentials.
# Alternatively use ~/.config/cedar/runtime.env, or set CEDAR_ENV_FILE.
CEDAR_DATABASE_URL=postgresql://cedar_app:replace-me@localhost:5432/cedar

# Importer only: use a separate private CEDAR_ENV_FILE in production.
# The HTTP application never resolves this source or opens lake files.
CEDAR_LAKE_READER_DATABASE_URL=
CEDAR_LAKE_ROOT=/srv/qrant-data/datasets
